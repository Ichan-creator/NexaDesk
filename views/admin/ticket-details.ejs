<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    NexaDesk | <%= ticket.ticket_number %>
  </title>

  <link
    rel="stylesheet"
    href="/css/base.css"
  >

  <link
    rel="stylesheet"
    href="/css/admin.css"
  >

  <link
    rel="stylesheet"
    href="/css/responsive.css"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>

    .ticket-page {
      padding: 30px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .ticket-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
    }

    .ticket-header h1 {
      margin: 0;
    }

    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 8px;
      text-decoration: none;
      border: 1px solid #ddd;
    }

    .ticket-info {
      background: #fff;
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }

    .ticket-info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 20px;
    }

    .info-item strong {
      display: block;
      margin-bottom: 5px;
    }

    .ticket-message {
      margin-top: 25px;
      padding: 20px;
      background: #f7f8fa;
      border-radius: 10px;
    }

    .ticket-message p {
      white-space: pre-wrap;
      margin: 10px 0 0;
    }

    .conversation {
      background: #fff;
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }

    .conversation h2 {
      margin-top: 0;
    }

    .message {
      padding: 16px;
      border-radius: 10px;
      margin-bottom: 15px;
      background: #f5f6f8;
    }

    .message.admin {
      background: #eef5ff;
      border-left: 4px solid #2563eb;
    }

    .message.user {
      background: #f7f7f7;
      border-left: 4px solid #777;
    }

    .message-header {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 8px;
    }

    .message-author {
      font-weight: 700;
    }

    .message-date {
      font-size: 13px;
      opacity: 0.65;
    }

    .message p {
      margin: 0;
      white-space: pre-wrap;
    }

    .reply-box {
      background: #fff;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }

    .reply-box h2 {
      margin-top: 0;
    }

    .reply-box textarea {
      width: 100%;
      min-height: 150px;
      resize: vertical;
      padding: 14px;
      border: 1px solid #d5d8dd;
      border-radius: 8px;
      font-family: inherit;
      font-size: 15px;
      box-sizing: border-box;
    }

    .reply-button {
      margin-top: 15px;
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
    }

    .alert {
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .alert-success {
      background: #e8f7ee;
      color: #166534;
    }

    .alert-error {
      background: #fdecec;
      color: #991b1b;
    }

    @media (max-width: 768px) {

      .ticket-page {
        padding: 20px 15px;
      }

      .ticket-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .ticket-info-grid {
        grid-template-columns: 1fr;
      }

      .message-header {
        flex-direction: column;
        gap: 4px;
      }

    }

  </style>

</head>

<body>

  <main class="ticket-page">

    <!-- HEADER -->

    <div class="ticket-header">

      <div>

        <h1>
          <%= ticket.ticket_number %>
        </h1>

        <p>
          Ticket Details
        </p>

      </div>

      <a
        href="/admin"
        class="back-button"
      >
        <i class="fa-solid fa-arrow-left"></i>
        Back to Dashboard
      </a>

    </div>


    <!-- FLASH MESSAGES -->

    <% if (success) { %>

      <div class="alert alert-success">
        <%= success %>
      </div>

    <% } %>


    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>


    <!-- TICKET INFORMATION -->

    <section class="ticket-info">

      <h2>
        <%= ticket.subject %>
      </h2>

      <div class="ticket-info-grid">

        <div class="info-item">

          <strong>
            User
          </strong>

          <span>
            <%= ticket.full_name %>
          </span>

        </div>


        <div class="info-item">

          <strong>
            Email
          </strong>

          <span>
            <%= ticket.email %>
          </span>

        </div>


        <div class="info-item">

          <strong>
            Department
          </strong>

          <span>
            <%= ticket.department %>
          </span>

        </div>


        <div class="info-item">

          <strong>
            Status
          </strong>

          <span>
            <%= ticket.status %>
          </span>

        </div>


        <div class="info-item">

          <strong>
            Priority
          </strong>

          <span>
            <%= ticket.priority %>
          </span>

        </div>


        <div class="info-item">

          <strong>
            Created
          </strong>

          <span>
            <%= ticket.created_at %>
          </span>

        </div>

      </div>


      <!-- ORIGINAL USER MESSAGE -->

      <div class="ticket-message">

        <strong>
          Original User Message
        </strong>

        <p>
          <%= ticket.description || ticket.message || "No message provided." %>
        </p>

      </div>

    </section>


    <!-- CONVERSATION -->

    <section class="conversation">

      <h2>
        <i class="fa-solid fa-comments"></i>
        Conversation
      </h2>


      <% if (updates && updates.length > 0) { %>

        <% updates.forEach(update => { %>

          <div
            class="message <%= update.role === 'admin' ? 'admin' : 'user' %>"
          >

            <div class="message-header">

              <span class="message-author">

                <%= update.full_name %>

                <% if (update.role === "admin") { %>

                  <span>
                    (Admin)
                  </span>

                <% } %>

              </span>

              <span class="message-date">

                <%= update.created_at %>

              </span>

            </div>


            <p>
              <%= update.note %>
            </p>

          </div>

        <% }) %>

      <% } else { %>

        <p>
          No replies or updates yet.
        </p>

      <% } %>

    </section>


    <!-- ADMIN REPLY -->

    <section class="reply-box">

      <h2>
        <i class="fa-solid fa-reply"></i>
        Reply to User
      </h2>

      <form
        action="/admin/tickets/<%= ticket.id %>/reply"
        method="POST"
      >

        <textarea
          name="message"
          placeholder="Type your response to the user..."
          required
        ></textarea>

        <button
          type="submit"
          class="btn btn-primary reply-button"
        >

          <i class="fa-solid fa-paper-plane"></i>

          Send Reply

        </button>

      </form>

    </section>

  </main>

</body>

</html>