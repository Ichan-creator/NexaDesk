<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        NexaDesk | <%= ticket.ticket_number %>
    </title>

    <link
        rel="stylesheet"
        href="/css/base.css"
    >

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

    <link
        rel="stylesheet"
        href="/css/responsive.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        .ticket-page {
            padding: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .ticket-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .ticket-header h1 {
            margin: 0;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid #ddd;
        }

        .ticket-info {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .ticket-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
            margin-top: 20px;
        }

        .info-item strong {
            display: block;
            margin-bottom: 5px;
        }

        .ticket-message {
            margin-top: 25px;
            padding: 20px;
            background: #f7f8fa;
            border-radius: 10px;
        }

        .ticket-message p {
            white-space: pre-wrap;
            margin: 10px 0 0;
        }

        /* STATUS BADGE */

        .status-badge {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
        }

        .status-open {
            background: #e0f2fe;
            color: #0369a1;
        }

        .status-in-progress {
            background: #fef3c7;
            color: #92400e;
        }

        .status-resolved {
            background: #dcfce7;
            color: #166534;
        }

        .status-closed {
            background: #e5e7eb;
            color: #374151;
        }

        /* TICKET UPDATE */

        .ticket-update-box {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .section-heading {
            margin-bottom: 22px;
        }

        .section-heading h2 {
            margin: 0 0 6px;
        }

        .section-heading p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .update-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
            margin-bottom: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }

        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d5d8dd;
            border-radius: 8px;
            background: #fff;
            font-family: inherit;
            font-size: 14px;
            box-sizing: border-box;
        }

        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        .update-button {
            margin-top: 5px;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

        /* CONVERSATION */

        .conversation {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .conversation h2 {
            margin-top: 0;
        }

        .message {
            padding: 16px;
            border-radius: 10px;
            margin-bottom: 15px;
            background: #f5f6f8;
        }

        .message.admin {
            background: #eef5ff;
            border-left: 4px solid #2563eb;
        }

        .message.user {
            background: #f7f7f7;
            border-left: 4px solid #777;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 8px;
        }

        .message-author {
            font-weight: 700;
        }

        .message-date {
            font-size: 13px;
            opacity: 0.65;
        }

        .message p {
            margin: 0;
            white-space: pre-wrap;
        }

        /* REPLY */

        .reply-box {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .reply-box h2 {
            margin-top: 0;
        }

        .reply-box textarea {
            width: 100%;
            min-height: 150px;
            resize: vertical;
            padding: 14px;
            border: 1px solid #d5d8dd;
            border-radius: 8px;
            font-family: inherit;
            font-size: 15px;
            box-sizing: border-box;
        }

        .reply-button {
            margin-top: 15px;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

        /* ALERTS */

        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #e8f7ee;
            color: #166534;
        }

        .alert-error {
            background: #fdecec;
            color: #991b1b;
        }

        /* RESPONSIVE */

        @media (max-width: 768px) {

            .ticket-page {
                padding: 20px 15px;
            }

            .ticket-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .ticket-info-grid {
                grid-template-columns: 1fr;
            }

            .update-grid {
                grid-template-columns: 1fr;
            }

            .message-header {
                flex-direction: column;
                gap: 4px;
            }

        }

    </style>

</head>

<body>

    <main class="ticket-page">

        <!-- HEADER -->

        <div class="ticket-header">

            <div>

                <h1>
                    <%= ticket.ticket_number %>
                </h1>

                <p>
                    Ticket Details
                </p>

            </div>

            <a
                href="/admin"
                class="back-button"
            >

                <i class="fa-solid fa-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>


        <!-- FLASH MESSAGES -->

        <% if (success) { %>

            <div class="alert alert-success">
                <%= success %>
            </div>

        <% } %>


        <% if (error) { %>

            <div class="alert alert-error">
                <%= error %>
            </div>

        <% } %>


        <!-- TICKET INFORMATION -->

        <section class="ticket-info">

            <h2>
                <%= ticket.subject %>
            </h2>

            <div class="ticket-info-grid">

                <div class="info-item">

                    <strong>
                        User
                    </strong>

                    <span>
                        <%= ticket.full_name %>
                    </span>

                </div>


                <div class="info-item">

                    <strong>
                        Email
                    </strong>

                    <span>
                        <%= ticket.email %>
                    </span>

                </div>


                <div class="info-item">

                    <strong>
                        Department
                    </strong>

                    <span>
                        <%= ticket.department %>
                    </span>

                </div>


                <div class="info-item">

                    <strong>
                        Status
                    </strong>

                    <span class="status-badge status-<%= ticket.status.toLowerCase().replace(/\s+/g, '-') %>">
                        <%= ticket.status %>
                    </span>

                </div>


                <div class="info-item">

                    <strong>
                        Priority
                    </strong>

                    <span>
                        <%= ticket.priority %>
                    </span>

                </div>


                <div class="info-item">

                    <strong>
                        Created
                    </strong>

                    <span>
                        <%= ticket.created_at %>
                    </span>

                </div>

            </div>


            <!-- ORIGINAL USER MESSAGE -->

            <div class="ticket-message">

                <strong>
                    Original User Message
                </strong>

                <p>
                    <%= ticket.description || ticket.message || "No message provided." %>
                </p>

            </div>

        </section>


        <!-- ADMIN TICKET UPDATE -->

        <section class="ticket-update-box">

            <div class="section-heading">

                <div>

                    <h2>
                        <i class="fa-solid fa-sliders"></i>
                        Update Ticket
                    </h2>

                    <p>
                        Change the ticket status or priority.
                    </p>

                </div>

            </div>


            <form
                action="/admin/tickets/<%= ticket.id %>/update"
                method="POST"
                class="ticket-update-form"
            >

                <div class="update-grid">

                    <!-- STATUS -->

                    <div class="form-group">

                        <label for="status">
                            Status
                        </label>

                        <select
                            id="status"
                            name="status"
                            required
                        >

                            <option
                                value="Open"
                                <%= ticket.status === "Open" ? "selected" : "" %>
                            >
                                Open
                            </option>

                            <option
                                value="In Progress"
                                <%= ticket.status === "In Progress" ? "selected" : "" %>
                            >
                                In Progress
                            </option>

                            <option
                                value="Resolved"
                                <%= ticket.status === "Resolved" ? "selected" : "" %>
                            >
                                Resolved
                            </option>

                            <option
                                value="Closed"
                                <%= ticket.status === "Closed" ? "selected" : "" %>
                            >
                                Closed
                            </option>

                        </select>

                    </div>


                    <!-- PRIORITY -->

                    <div class="form-group">

                        <label for="priority">
                            Priority
                        </label>

                        <select
                            id="priority"
                            name="priority"
                            required
                        >

                            <option
                                value="Low"
                                <%= ticket.priority === "Low" ? "selected" : "" %>
                            >
                                Low
                            </option>

                            <option
                                value="Medium"
                                <%= ticket.priority === "Medium" ? "selected" : "" %>
                            >
                                Medium
                            </option>

                            <option
                                value="High"
                                <%= ticket.priority === "High" ? "selected" : "" %>
                            >
                                High
                            </option>

                            <option
                                value="Urgent"
                                <%= ticket.priority === "Urgent" ? "selected" : "" %>
                            >
                                Urgent
                            </option>

                        </select>

                    </div>

                </div>


                <!-- OPTIONAL UPDATE NOTE -->

                <div class="form-group">

                    <label for="note">
                        Update Note
                    </label>

                    <textarea
                        id="note"
                        name="note"
                        rows="4"
                        placeholder="Add an optional note about this update..."
                    ></textarea>

                </div>


                <button
                    type="submit"
                    class="btn btn-primary update-button"
                >

                    <i class="fa-solid fa-save"></i>

                    Update Ticket

                </button>

            </form>

        </section>


        <!-- CONVERSATION -->

        <section class="conversation">

            <h2>

                <i class="fa-solid fa-comments"></i>

                Conversation

            </h2>


            <% if (updates && updates.length > 0) { %>

                <% updates.forEach(update => { %>

                    <div
                        class="message <%= update.role === 'admin' ? 'admin' : 'user' %>"
                    >

                        <div class="message-header">

                            <span class="message-author">

                                <%= update.full_name %>

                                <% if (update.role === "admin") { %>

                                    <span>
                                        (Admin)
                                    </span>

                                <% } %>

                            </span>


                            <span class="message-date">
                                <%= update.created_at %>
                            </span>

                        </div>


                        <p>
                            <%= update.note %>
                        </p>

                    </div>

                <% }) %>

            <% } else { %>

                <p>
                    No replies or updates yet.
                </p>

            <% } %>

        </section>


        <!-- ADMIN REPLY -->

        <section class="reply-box">

            <h2>

                <i class="fa-solid fa-reply"></i>

                Reply to User

            </h2>


            <form
                action="/admin/tickets/<%= ticket.id %>/reply"
                method="POST"
            >

                <textarea
                    name="note"
                    placeholder="Type your response to the user..."
                    required
                ></textarea>


                <button
                    type="submit"
                    class="btn btn-primary reply-button"
                >

                    <i class="fa-solid fa-paper-plane"></i>

                    Send Reply

                </button>

            </form>

        </section>

    </main>

</body>

</html>