<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>NexaDesk | Admin Login</title>

  <link
    rel="stylesheet"
    href="/css/base.css"
  >

  <link
    rel="stylesheet"
    href="/css/auth.css"
  >

  <link
    rel="stylesheet"
    href="/css/responsive.css"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

</head>


<body>

  <div class="auth-page">

    <!-- LEFT BRAND SECTION -->

    <section class="auth-brand">

      <h1>
        Nexa<span>Desk</span>
      </h1>

      <p>
        A modern IT Service Desk platform for managing technical
        support requests, incidents, and service tickets.
      </p>


      <div class="auth-features">

        <div class="auth-feature">

          <i class="fa-solid fa-ticket"></i>

          <span>
            Track and manage IT support tickets
          </span>

        </div>


        <div class="auth-feature">

          <i class="fa-solid fa-users-gear"></i>

          <span>
            Manage users and service desk operations
          </span>

        </div>


        <div class="auth-feature">

          <i class="fa-solid fa-chart-line"></i>

          <span>
            Monitor ticket status and service activity
          </span>

        </div>

      </div>

    </section>


    <!-- RIGHT LOGIN SECTION -->

    <section class="auth-panel">

      <div class="auth-card">


        <!-- HEADER -->

        <div class="auth-card-header">

          <h2>
            Admin Login
          </h2>

          <p>
            Sign in to access the NexaDesk administration panel.
          </p>

        </div>


        <!-- SUCCESS MESSAGE -->

        <% if (success) { %>

          <div class="alert alert-success">
            <%= success %>
          </div>

        <% } %>


        <!-- ERROR MESSAGE -->

        <% if (error) { %>

          <div class="alert alert-error">
            <%= error %>
          </div>

        <% } %>


        <!-- ADMIN LOGIN FORM -->

        <form
          action="/admin/login"
          method="POST"
        >


          <!-- USERNAME -->

          <div class="form-group">

            <label for="adminUsername">
              Admin Username
            </label>

            <input
              type="text"
              id="adminUsername"
              name="username"
              class="form-control"
              placeholder="Enter admin username"
              autocomplete="username"
              required
            >

          </div>


          <!-- PASSWORD -->

          <div class="form-group">

            <label for="password">
              Password
            </label>


            <div class="password-wrapper">

              <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              >


              <button
                type="button"
                class="password-toggle"
                aria-label="Show or hide password"
              >

                <i class="fa-solid fa-eye"></i>

              </button>

            </div>

          </div>


          <!-- LOGIN BUTTON -->

          <button
            type="submit"
            class="btn btn-primary"
            style="width: 100%;"
          >

            <i class="fa-solid fa-shield-halved"></i>

            Admin Sign In

          </button>

        </form>


        <!-- BACK TO USER LOGIN -->

        <div class="auth-footer">

          <a href="/login">

            <i class="fa-solid fa-arrow-left"></i>

            Back to User Login

          </a>

        </div>


      </div>

    </section>

  </div>


  <script src="/js/auth.js"></script>

</body>

</html>