<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"

>

  <title>NexaDesk | Dashboard</title>

  <link
    rel="stylesheet"
    href="/css/base.css"
  >

  <link
    rel="stylesheet"
    href="/css/sidebar.css"
  >

  <link
    rel="stylesheet"
    href="/css/topbar.css"
  >

  <link
    rel="stylesheet"
    href="/css/dashboard.css"
  >

  <link
    rel="stylesheet"
    href="/css/responsive.css"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

</head>

<body>

<!-- ========================================
     SIDEBAR
     USER ONLY
     ======================================== -->

<aside
  class="sidebar"
  id="sidebar"
>

  <div class="sidebar-logo">

<h2>
  Nexa<span>Desk</span>
</h2>

  </div>

  <nav class="sidebar-nav">

<!-- ========================================
     WORKSPACE
     ======================================== -->

<div class="nav-label">
  Workspace
</div>


<a
  href="/dashboard"
  class="nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>"
>

  <i class="fa-solid fa-chart-line"></i>

  Dashboard

</a>


<a
  href="/tickets"
  class="nav-item <%= currentPath.startsWith('/tickets') && currentPath !== '/tickets/new' ? 'active' : '' %>"
>

  <i class="fa-solid fa-ticket"></i>

  My Tickets

</a>


<a
  href="/tickets/new"
  class="nav-item <%= currentPath === '/tickets/new' ? 'active' : '' %>"
>

  <i class="fa-solid fa-plus"></i>

  New Ticket

</a>


<a
  href="/knowledge-base"
  class="nav-item <%= currentPath.startsWith('/knowledge-base') ? 'active' : '' %>"
>

  <i class="fa-solid fa-book"></i>

  Knowledge Base

</a>


<!-- ========================================
     ACCOUNT
     ======================================== -->

<div
  class="nav-label"
  style="margin-top:25px;"
>

  Account

</div>


<a
  href="/profile"
  class="nav-item <%= currentPath.startsWith('/profile') ? 'active' : '' %>"
>

  <i class="fa-solid fa-user"></i>

  Profile

</a>


<a
  href="/notifications"
  class="nav-item <%= currentPath.startsWith('/notifications') ? 'active' : '' %>"
>

  <i class="fa-solid fa-bell"></i>

  Notifications

</a>


<!-- ========================================
     LOGOUT
     ======================================== -->

<form
  action="/logout"
  method="POST"
  style="margin-top:15px;"
>

  <button
    type="submit"
    class="nav-item"
    style="
      width:100%;
      border:none;
      background:transparent;
      text-align:left;
    "
  >

    <i class="fa-solid fa-right-from-bracket"></i>

    Logout

  </button>

</form>


  </nav>

  <!-- ========================================
       SIDEBAR USER
       ======================================== -->

  <div class="sidebar-user">

<div class="sidebar-user-info">

  <div class="sidebar-avatar">

    <%= user.fullName
      .split(" ")
      .map(name => name[0])
      .slice(0,2)
      .join("")
      .toUpperCase()
    %>

  </div>


  <div class="sidebar-user-text">

    <strong>
      <%= user.fullName %>
    </strong>

    <small>
      <%= user.role %>
    </small>

  </div>

</div>

  </div>

</aside>

<!-- ========================================
     TOPBAR
     ======================================== -->

<header class="topbar">

<button
class="mobile-menu"
id="mobileMenu"
type="button"

>

<i class="fa-solid fa-bars"></i>

  </button>

  <div class="topbar-search">

<i class="fa-solid fa-magnifying-glass"></i>

<input
  type="text"
  id="globalSearch"
  placeholder="Search tickets..."
>

  </div>

  <div class="topbar-right">

<a
  href="/notifications"
  class="topbar-icon"
  aria-label="Notifications"
>

  <i class="fa-regular fa-bell"></i>

  <span class="notification-dot"></span>

</a>


<div class="topbar-user">

  <div class="topbar-avatar">

    <%= user.fullName
      .split(" ")
      .map(name => name[0])
      .slice(0,2)
      .join("")
      .toUpperCase()
    %>

  </div>


  <div class="topbar-user-info">

    <strong>
      <%= user.fullName %>
    </strong>

    <span>
      <%= user.department %>
    </span>

  </div>

</div>


  </div>

</header>

<!-- ========================================
     MAIN
     ======================================== -->

<main class="main-content">

  <div class="page-container">


<!-- ========================================
     ALERTS
     ======================================== -->

<% if (success) { %>

  <div class="alert alert-success">

    <%= success %>

  </div>

<% } %>


<% if (error) { %>

  <div class="alert alert-error">

    <%= error %>

  </div>

<% } %>



<!-- ========================================
     WELCOME
     ======================================== -->

<section class="welcome-card">

  <h1>

    Welcome back,

    <%= user.fullName.split(" ")[0] %> 👋

  </h1>


  <p>

    Here's an overview of your IT support activity.

  </p>


  <div class="dashboard-actions">

    <a
      href="/tickets/new"
      class="btn btn-primary"
    >

      <i class="fa-solid fa-plus"></i>

      Create New Ticket

    </a>

  </div>

</section>



<!-- ========================================
     STATISTICS
     ======================================== -->

<div class="stats-grid">


  <!-- TOTAL TICKETS -->

  <div class="stat-card">

    <div class="stat-top">

      <span class="stat-label">

        Total Tickets

      </span>


      <div class="stat-icon">

        <i class="fa-solid fa-ticket"></i>

      </div>

    </div>


    <div class="stat-number">

      <%= stats.total || 0 %>

    </div>

  </div>



  <!-- OPEN -->

  <div class="stat-card">

    <div class="stat-top">

      <span class="stat-label">

        Open

      </span>


      <div class="stat-icon">

        <i class="fa-solid fa-folder-open"></i>

      </div>

    </div>


    <div class="stat-number">

      <%= stats.open || 0 %>

    </div>

  </div>



  <!-- IN PROGRESS -->

  <div class="stat-card">

    <div class="stat-top">

      <span class="stat-label">

        In Progress

      </span>


      <div class="stat-icon">

        <i class="fa-solid fa-spinner"></i>

      </div>

    </div>


    <div class="stat-number">

      <%= stats.inProgress || 0 %>

    </div>

  </div>



  <!-- RESOLVED -->

  <div class="stat-card">

    <div class="stat-top">

      <span class="stat-label">

        Resolved

      </span>


      <div class="stat-icon">

        <i class="fa-solid fa-circle-check"></i>

      </div>

    </div>


    <div class="stat-number">

      <%= stats.resolved || 0 %>

    </div>

  </div>

</div>



<!-- ========================================
     DASHBOARD CONTENT
     ======================================== -->

<div class="dashboard-grid">


  <!-- ========================================
       RECENT TICKETS
       ======================================== -->

  <section class="section-card">

    <div class="section-header">

      <h2>
        Recent Tickets
      </h2>


      <a href="/tickets">
        View all
      </a>

    </div>


    <% if (recentTickets && recentTickets.length > 0) { %>

      <% recentTickets.forEach(ticket => { %>

        <a
          href="/tickets/<%= ticket.id %>"
          class="ticket-row"
        >

          <div class="ticket-info">

            <h3>
              <%= ticket.subject %>
            </h3>

            <p>
              <%= ticket.ticket_number %>
            </p>

          </div>


          <span
            class="badge
            <%= ticket.status === 'Open'
              ? 'status-open'
              : ticket.status === 'In Progress'
              ? 'status-progress'
              : ticket.status === 'Resolved'
              ? 'status-resolved'
              : 'status-closed' %>"
          >

            <%= ticket.status %>

          </span>

        </a>

      <% }) %>


    <% } else { %>


      <div class="empty-state">

        <i class="fa-solid fa-ticket"></i>

        <h3>
          No tickets yet
        </h3>

        <p>
          Create your first support ticket.
        </p>

      </div>


    <% } %>

  </section>



  <!-- ========================================
       NOTIFICATIONS
       ======================================== -->

  <section class="section-card">

    <div class="section-header">

      <h2>
        Notifications
      </h2>


      <a href="/notifications">
        View all
      </a>

    </div>


    <% if (notifications && notifications.length > 0) { %>

      <% notifications
        .slice(0, 5)
        .forEach(notification => { %>

        <div class="notification-item">

          <strong>
            <%= notification.title %>
          </strong>

          <p>
            <%= notification.message %>
          </p>

        </div>

      <% }) %>


    <% } else { %>


      <div class="empty-state">

        <i class="fa-regular fa-bell"></i>

        <h3>
          All caught up
        </h3>

        <p>
          No new notifications.
        </p>

      </div>


    <% } %>

  </section>


</div>

  </div>

</main>

<script src="/js/main.js"></script>

<script src="/js/dashboard.js"></script>

</body>

</html>
