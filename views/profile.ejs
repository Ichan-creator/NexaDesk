<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NexaDesk | Profile</title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/topbar.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/responsive.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >
</head>

<body>

<aside class="sidebar" id="sidebar">

  <div class="sidebar-logo">
    <h2>Nexa<span>Desk</span></h2>
  </div>

  <nav class="sidebar-nav">

    <div class="nav-label">Workspace</div>

    <a href="/dashboard" class="nav-item">
      <i class="fa-solid fa-chart-line"></i>
      Dashboard
    </a>

    <a href="/tickets" class="nav-item">
      <i class="fa-solid fa-ticket"></i>
      My Tickets
    </a>

    <a href="/tickets/new" class="nav-item">
      <i class="fa-solid fa-plus"></i>
      New Ticket
    </a>

    <a href="/knowledge-base" class="nav-item">
      <i class="fa-solid fa-book"></i>
      Knowledge Base
    </a>

    <div class="nav-label" style="margin-top:25px;">
      Account
    </div>

    <a href="/profile" class="nav-item active">
      <i class="fa-solid fa-user"></i>
      Profile
    </a>

    <a href="/notifications" class="nav-item">
      <i class="fa-solid fa-bell"></i>
      Notifications
    </a>

    <% if (user && user.role === "admin") { %>
      <a href="/admin" class="nav-item">
        <i class="fa-solid fa-shield-halved"></i>
        Admin Dashboard
      </a>
    <% } %>

    <form action="/logout" method="POST" style="margin-top:15px;">
      <button
        type="submit"
        class="nav-item"
        style="width:100%; border:none; background:transparent; text-align:left;"
      >
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
      </button>
    </form>

  </nav>

</aside>


<header class="topbar">

  <button class="mobile-menu" id="mobileMenu" type="button">
    <i class="fa-solid fa-bars"></i>
  </button>

  <div class="topbar-search">

    <i class="fa-solid fa-magnifying-glass"></i>

    <input
      type="text"
      id="globalSearch"
      placeholder="Search tickets..."
    >

  </div>

  <div class="topbar-right">

    <a href="/notifications" class="topbar-icon">
      <i class="fa-regular fa-bell"></i>
    </a>

    <div class="topbar-user">

      <div class="topbar-avatar">
        <%= user.fullName
          .split(" ")
          .map(name => name[0])
          .slice(0,2)
          .join("")
          .toUpperCase() %>
      </div>

      <div class="topbar-user-info">
        <strong><%= user.fullName %></strong>
        <span><%= user.department %></span>
      </div>

    </div>

  </div>

</header>


<main class="main-content">

  <div class="page-container">

    <div class="page-header">

      <h1>My Profile</h1>

      <p>
        Manage your account information and password.
      </p>

    </div>


    <% if (success) { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>


    <div class="profile-layout">


      <!-- PROFILE -->
      <section class="profile-card">

        <div class="profile-avatar">

          <%= user.fullName
            .split(" ")
            .map(name => name[0])
            .slice(0,2)
            .join("")
            .toUpperCase() %>

        </div>

        <h2>
          <%= user.fullName %>
        </h2>

        <p>
          <%= user.email %>
        </p>

        <span class="profile-role">
          <%= user.role.toUpperCase() %>
        </span>

      </section>


      <!-- FORM -->
      <section class="profile-form">

        <h2>
          Account Information
        </h2>

        <div class="form-group">

          <label>Full Name</label>

          <input
            type="text"
            class="form-control"
            value="<%= user.fullName %>"
            disabled
          >

        </div>

        <div class="form-group">

          <label>Email Address</label>

          <input
            type="email"
            class="form-control"
            value="<%= user.email %>"
            disabled
          >

        </div>

        <div class="form-group">

          <label>Department</label>

          <input
            type="text"
            class="form-control"
            value="<%= user.department %>"
            disabled
          >

        </div>


        <hr style="border:none;border-top:1px solid #e2e8f0;margin:30px 0;">


        <h2>
          Change Password
        </h2>

        <form
          action="/profile/password"
          method="POST"
          id="passwordForm"
        >

          <div class="form-group">

            <label for="current_password">
              Current Password
            </label>

            <input
              type="password"
              id="current_password"
              name="current_password"
              class="form-control"
              required
            >

          </div>


          <div class="form-group">

            <label for="new_password">
              New Password
            </label>

            <input
              type="password"
              id="new_password"
              name="new_password"
              class="form-control"
              minlength="8"
              required
            >

          </div>


          <div class="form-group">

            <label for="confirm_password">
              Confirm New Password
            </label>

            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              class="form-control"
              minlength="8"
              required
            >

          </div>


          <button
            type="submit"
            class="btn btn-primary"
          >
            <i class="fa-solid fa-lock"></i>
            Update Password
          </button>

        </form>

      </section>

    </div>

  </div>

</main>


<script src="/js/main.js"></script>
<script src="/js/profile.js"></script>

</body>
</html>