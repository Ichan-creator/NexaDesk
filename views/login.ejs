<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NexaDesk | Login</title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/responsive.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >
</head>

<body>

<div class="auth-page">

  <section class="auth-brand">
    <h1>Nexa<span>Desk</span></h1>

    <p>
      A modern IT Service Desk platform for managing technical
      support requests, incidents, and service tickets.
    </p>

    <div class="auth-features">
      <div class="auth-feature">
        <i class="fa-solid fa-ticket"></i>
        <span>Track and manage IT support tickets</span>
      </div>

      <div class="auth-feature">
        <i class="fa-solid fa-book"></i>
        <span>Access troubleshooting knowledge articles</span>
      </div>

      <div class="auth-feature">
        <i class="fa-solid fa-bell"></i>
        <span>Stay updated with ticket notifications</span>
      </div>
    </div>
  </section>

  <section class="auth-panel">

    <div class="auth-card">

      <div class="auth-card-header">
        <h2>Welcome back</h2>
        <p>Sign in to your NexaDesk account.</p>
      </div>

      <% if (success) { %>
        <div class="alert alert-success">
          <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">

        <div class="form-group">
          <label for="email">Email Address</label>

          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>

          <div class="password-wrapper">

            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            >

            <button
              type="button"
              class="password-toggle"
              aria-label="Show or hide password"
            >
              <i class="fa-solid fa-eye"></i>
            </button>

          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;">
          <i class="fa-solid fa-right-to-bracket"></i>
          Sign In
        </button>

      </form>

        <div class="auth-footer">

        <div>
            Don't have an account?
            <a href="/register">Create an account</a>
        </div>

        <div style="margin-top: 16px;">
            <a href="/admin/login" class="admin-login-link">
                <i class="fa-solid fa-shield-halved"></i>
                Admin Login
            </a>
        </div>

        </div>

  </section>

</div>

<script src="/js/auth.js"></script>

</body>
</html>